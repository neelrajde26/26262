# ============================================
# AICTE FlowGuard — Environment Configuration Template
# Copy this file to .env and set your deployment values
# ============================================

# HTTP Server Port
PORT=5500

# Application Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Session JWT Signing Secret (REQUIRED IN PRODUCTION: minimum 32 random characters)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-32-character-secret-in-production

# External Alert Channels (Optional: if empty, alerts are delivered exclusively in-app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AICTE FlowGuard <noreply@flowguard.aicte.gov.in>"
